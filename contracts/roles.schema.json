{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm-os/roles@1",
  "title": "Role sheet (roles.yaml)",
  "type": "object",
  "required": [
    "roles"
  ],
  "additionalProperties": false,
  "properties": {
    "roles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "agent",
          "tier",
          "persona",
          "skills"
        ],
        "additionalProperties": false,
        "properties": {
          "agent": {
            "enum": [
              "worker",
              "reviewer"
            ]
          },
          "tier": {
            "enum": [
              "small",
              "mid",
              "top"
            ]
          },
          "persona": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rubric": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "principles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effort": {
            "enum": [
              "low",
              "medium",
              "high",
              "max"
            ],
            "description": "How hard the model reasons (tier picks the model). Resolved per task: task new --effort > mode > role > agent > defaults.effort; risk high/low then moves it one level, clamped by effort.min/max"
          },
          "dispatch": {
            "enum": [
              "background",
              "foreground"
            ],
            "description": "How the CoS runs the subagent: background (start it, return to the PM, report when it lands) or foreground (wait). Resolved like effort: task new --dispatch > mode > role > agent > defaults.dispatch"
          }
        }
      }
    }
  }
}
