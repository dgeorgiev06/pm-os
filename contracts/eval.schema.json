{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pm-os/eval@1",
  "title": "Eval case (eval@1)",
  "description": "One eval case. Two kinds share this schema: `conformance` (code only, no model: setup, steps, capture, expect; YAML in <pack>/evals/conformance/ or, for core, evals/framework/<group>/) and `golden` (model-graded: envelope, fixtures, gates, expect lines; JSON in <pack>/modes/<mode>/evals/ or <pack>/evals/workflows/). Every case says which features it covers; admission requires every feature to be covered (see evals/framework/README.md).",
  "type": "object",
  "required": ["kind", "name", "covers"],
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^(mode:[a-z0-9-]+/[a-z0-9-]+|router:[a-z0-9-]+/[a-z0-9-]+|action:[a-z0-9_-]+\\.[a-z0-9_-]+|principle:[a-z0-9-]+:[a-z0-9-]+|script:(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+)$",
      "description": "A feature of the case's own pack: mode:<pack>/<mode>, router:<pack>/<mode>, action:<system>.<op> (a handler in pack.yaml `actions:`), script:<path relative to the pack> (core: relative to the repo root), principle:<pack>:<name> (optional)"
    },
    "covers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ref" },
      "description": "The features this case tests"
    },
    "regexes": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit": { "oneOf": [{ "enum": ["nonzero", "any"] }, { "type": "integer" }] },
        "stdout": { "$ref": "#/$defs/regexes" },
        "stdout_not": { "$ref": "#/$defs/regexes" },
        "stderr": { "$ref": "#/$defs/regexes" },
        "stderr_not": { "$ref": "#/$defs/regexes" },
        "output": { "$ref": "#/$defs/regexes" },
        "output_not": { "$ref": "#/$defs/regexes" },
        "task": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "state": { "type": "string" },
            "fields": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
            "absent": { "$ref": "#/$defs/regexes" }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exists": { "$ref": "#/$defs/regexes" },
            "absent": { "$ref": "#/$defs/regexes" },
            "contains": { "type": "object", "additionalProperties": { "$ref": "#/$defs/regexes" } },
            "not_contains": { "type": "object", "additionalProperties": { "$ref": "#/$defs/regexes" } }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["run"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "run": { "type": "string", "minLength": 1 },
        "capture": { "type": "object", "additionalProperties": { "type": "string" } },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "conformance": {
      "type": "object",
      "required": ["kind", "name", "covers", "steps"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "conformance" },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Unique within the pack; also the file name" },
        "covers": { "$ref": "#/$defs/covers" },
        "failure": { "type": "boolean", "description": "true: this case tests a failure path (a refusal, an error exit)" },
        "desc": { "type": "string" },
        "finding": { "type": "string", "description": "core cases: <review>#<n> in evals/framework/findings/, or request:<name> for an approved addition" },
        "owner": { "type": "string", "description": "Default: the folder (core) or the pack" },
        "severity": { "enum": ["low", "medium", "high"] },
        "regression": { "type": "boolean", "description": "Confirmed to work; must keep passing" },
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "install": { "type": "array", "items": { "type": "string" }, "description": "Fixture packs ($FX/packs/<name>) to copy to packs/<name> and install" },
            "copy": { "type": "object", "additionalProperties": { "type": "string" }, "description": "$FX/<from> -> <to in the sandbox>" },
            "files": { "type": "object", "additionalProperties": { "type": ["string", "object", "array"] } }
          }
        },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "golden": {
      "type": "object",
      "required": ["kind", "name", "covers", "envelope", "expect"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "golden" },
        "name": { "type": "string", "minLength": 1 },
        "covers": { "$ref": "#/$defs/covers" },
        "failure": { "type": "boolean", "description": "true: the sample task exercises a failure path (blocked, refused, bad input)" },
        "desc": { "type": "string" },
        "envelope": {
          "type": "object",
          "required": ["verb", "mode", "inputs"],
          "additionalProperties": false,
          "properties": {
            "verb": { "enum": ["plan", "draft", "analyze", "execute", "review"] },
            "mode": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+(@[~^]?[0-9]+(\\.[0-9]+){0,2})?$" },
            "inputs": { "type": "object" },
            "acceptance": { "type": "array", "items": { "type": "string" } },
            "risk": { "enum": ["low", "medium", "high"] },
            "approval": { "enum": ["none", "before_publish", "before_execute"] },
            "effort": { "enum": ["low", "medium", "high", "max"] }
          }
        },
        "fixtures": { "type": "object", "description": "name -> inline data or a path inside the pack" },
        "gates": { "type": "array", "items": { "type": "string" }, "description": "Answers to the mode's gates, in order" },
        "expect": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Lines a grader checks" }
      }
    }
  },
  "properties": {
    "kind": { "enum": ["conformance", "golden"] }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "conformance" } }, "required": ["kind"] }, "then": { "$ref": "#/$defs/conformance" } },
    { "if": { "properties": { "kind": { "const": "golden" } }, "required": ["kind"] }, "then": { "$ref": "#/$defs/golden" } }
  ]
}
